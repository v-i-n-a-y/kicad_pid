(page_layout
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 20) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (name frame_outer) (start -5 -5 ltcorner) (end -5 -5) (linewidth 0.35))
  (rect (name frame_main) (start 0 0 ltcorner) (end 0 0) (linewidth 0.7))
  (line (name zone_top) (start 50 -5 ltcorner) (end 50 0 ltcorner) (linewidth 0.35) (repeat 30) (incrx 50))
  (line (name zone_bottom) (start 50 -5 lbcorner) (end 50 0 lbcorner) (linewidth 0.35) (repeat 30) (incrx 50))
  (line (name zone_left) (start -5 50 ltcorner) (end 0 50 ltcorner) (linewidth 0.35) (repeat 30) (incry 50))
  (line (name zone_right) (start -5 50 rtcorner) (end 0 50 rtcorner) (linewidth 0.35) (repeat 30) (incry 50))
  (tbtext "1" (name zone_top_n) (pos 25 -2.5 ltcorner) (font (linewidth 0.35) (size 3 3)) (justify center) (repeat 100) (incrx 50))
  (tbtext "1" (name zone_bottom_n) (pos 25 -2.5 lbcorner) (font (linewidth 0.35) (size 3 3)) (justify center) (repeat 100) (incrx 50))
  (tbtext "A" (name zone_left_n) (pos -2.5 25 ltcorner) (font (linewidth 0.35) (size 3 3)) (justify center) (repeat 100) (incry 50))
  (tbtext "A" (name zone_right_n) (pos -2.5 25 rtcorner) (font (linewidth 0.35) (size 3 3)) (justify center) (repeat 100) (incry 50))
  (rect (name tb_frame) (start 180 48) (end 0 0) (linewidth 0.7))
  (line (name seg1) (start 180 38) (end 0 38) (linewidth 0.15))
  (line (name seg2) (start 180 22) (end 0 22) (linewidth 0.15))
  (line (name seg3) (start 180 11) (end 0 11) (linewidth 0.15))
  (tbtext "COMPANY" (name lbl4) (pos 179 47) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMPANY}" (name val5) (pos 179 42.5) (font bold (linewidth 0.4) (size 3.5 3.5)) (justify left))
  (tbtext "TITLE" (name lbl6) (pos 179 37) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${TITLE}" (name val7) (pos 179 29) (font bold (linewidth 0.5) (size 5 5)) (justify left))
  (line (name seg8) (start 110 11) (end 110 22) (linewidth 0.15))
  (line (name seg9) (start 50 11) (end 50 22) (linewidth 0.15))
  (line (name seg10) (start 30 11) (end 30 22) (linewidth 0.15))
  (tbtext "PROJECT" (name lbl11) (pos 179 21) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMMENT1}" (name val12) (pos 179 15) (font (linewidth 0.3) (size 3 3)) (justify left))
  (tbtext "DRAWING NUMBER" (name lbl13) (pos 109 21) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMMENT2}" (name val14) (pos 109 15) (font bold (linewidth 0.4) (size 3.5 3.5)) (justify left))
  (tbtext "REVISION" (name lbl15) (pos 49 21) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${REVISION}" (name val16) (pos 49 15) (font bold (linewidth 0.4) (size 3.5 3.5)) (justify left))
  (tbtext "SIZE" (name lbl17) (pos 29 21) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${PAPER}" (name val18) (pos 29 15) (font (linewidth 0.3) (size 3 3)) (justify left))
  (line (name seg19) (start 144 0) (end 144 11) (linewidth 0.15))
  (line (name seg20) (start 108 0) (end 108 11) (linewidth 0.15))
  (line (name seg21) (start 72 0) (end 72 11) (linewidth 0.15))
  (line (name seg22) (start 36 0) (end 36 11) (linewidth 0.15))
  (tbtext "DRAWN" (name lbl23) (pos 179 10) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMMENT3}" (name val24) (pos 179 4) (font (linewidth 0.3) (size 2.8 2.8)) (justify left))
  (tbtext "CHECKED" (name lbl25) (pos 143 10) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMMENT4}" (name val26) (pos 143 4) (font (linewidth 0.3) (size 2.8 2.8)) (justify left))
  (tbtext "APPROVED" (name lbl27) (pos 107 10) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${COMMENT5}" (name val28) (pos 107 4) (font (linewidth 0.3) (size 2.8 2.8)) (justify left))
  (tbtext "ISSUE DATE" (name lbl29) (pos 71 10) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${ISSUE_DATE}" (name val30) (pos 71 4) (font (linewidth 0.3) (size 2.8 2.8)) (justify left))
  (tbtext "SHEET" (name lbl31) (pos 35 10) (font (linewidth 0.15) (size 1.5 1.5)) (justify left top))
  (tbtext "${#} of ${##}" (name val32) (pos 35 4) (font bold (linewidth 0.4) (size 3 3)) (justify left))
  (rect (name rev_frame) (start 180 84) (end 0 48) (linewidth 0.5))
  (line (name seg33) (start 166 48) (end 166 84) (linewidth 0.15))
  (line (name seg34) (start 140 48) (end 140 84) (linewidth 0.15))
  (line (name seg35) (start 60 48) (end 60 84) (linewidth 0.15))
  (line (name seg36) (start 30 48) (end 30 84) (linewidth 0.15))
  (line (name seg37) (start 180 54) (end 0 54) (linewidth 0.15))
  (line (name seg38) (start 180 60) (end 0 60) (linewidth 0.15))
  (line (name seg39) (start 180 66) (end 0 66) (linewidth 0.15))
  (line (name seg40) (start 180 72) (end 0 72) (linewidth 0.15))
  (line (name seg41) (start 180 78) (end 0 78) (linewidth 0.35))
  (tbtext "REV" (name val42) (pos 179 81) (font (linewidth 0.2) (size 1.8 1.8)) (justify left))
  (tbtext "DATE" (name val43) (pos 165 81) (font (linewidth 0.2) (size 1.8 1.8)) (justify left))
  (tbtext "DESCRIPTION" (name val44) (pos 139 81) (font (linewidth 0.2) (size 1.8 1.8)) (justify left))
  (tbtext "BY" (name val45) (pos 59 81) (font (linewidth 0.2) (size 1.8 1.8)) (justify left))
  (tbtext "CHECKED" (name val46) (pos 29 81) (font (linewidth 0.2) (size 1.8 1.8)) (justify left))
  (tbtext "${REVISION}" (name val47) (pos 179 51) (font (linewidth 0.3) (size 2.5 2.5)) (justify left))
  (tbtext "${ISSUE_DATE}" (name val48) (pos 165 51) (font (linewidth 0.3) (size 2.2 2.2)) (justify left))
  (tbtext "${COMMENT6}" (name val49) (pos 139 51) (font (linewidth 0.3) (size 2.5 2.5)) (justify left))
  (tbtext "${COMMENT3}" (name val50) (pos 59 51) (font (linewidth 0.3) (size 2.5 2.5)) (justify left))
  (tbtext "${COMMENT4}" (name val51) (pos 29 51) (font (linewidth 0.3) (size 2.5 2.5)) (justify left))
)
